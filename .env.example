# Copy this file to .env (git ignores .env) and fill in the values.
# PUBLIC_ variables end up in the page visitors download, so never put a secret here.

# Google Apps Script web app the registration form sends applications to (AGENTS.md -> "Google Sheet").
# Put the TEST deployment's URL here, so local work and demos use the test Sheet, never the live one.
# To test without Google: run `npm run mock-sheet` and use http://localhost:8787/exec
# The published site will get the LIVE URL as a build setting on its host (AGENTS.md -> "Google Sheet").
PUBLIC_SHEET_API_URL=

# Cloudflare Turnstile ("Verify you are human" above the form's Submit button). The site key is public.
# Leave empty to hide the check. For testing anywhere, Cloudflare's test key 1x00000000000000000000AA always passes.
# The published site gets the real key from the GitHub variable of the same name.
PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (G-...). Leave it empty here, so local work and the demo don't count as
# visits; set it only to test the cookie banner. The published site gets it from the GitHub variable of the same name.
PUBLIC_GA_MEASUREMENT_ID=
