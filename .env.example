# Copy this file to .env (git ignores .env) and fill in the values.
# PUBLIC_ variables end up in the page visitors download, so never put a secret here.

# Google Apps Script web app the registration page talks to (planned; see AGENTS.md -> "Google Sheet").
# Put the TEST deployment's URL here, so local work and demos use the test Sheet, never the live one.
# The published site will get the LIVE URL as a build setting on its host (AGENTS.md -> "Google Sheet").
PUBLIC_SHEET_API_URL=
