---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Tabs from '../components/Tabs.astro';
import CourseSection from '../components/CourseSection.astro';
import Divider from '../components/Divider.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Register from '../components/Register.astro';
import ApplyForm from '../components/ApplyForm.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { courses } from '../data/courses';
import { nav, panels } from '../data/tabs';
import { registrationForms } from '../data/registration';

const micOnlineForm = registrationForms.find((f) => f.id === 'mic-online-2027') ?? registrationForms[0];
---

<Base>
  <Header />
  <Tabs nav={nav} />
  <main class="panels">
    {
      panels.map((id, i) => (
        <div
          role="tabpanel"
          id={id}
          aria-labelledby={`tab-${id}`}
          class:list={['panel', `panel--${id}`, i === 0 && 'is-active']}
        >
          {id === 'home' ? (
            <>
              <Hero />
              <About />
            </>
          ) : id === 'contact' ? (
            <Contact />
          ) : id === 'all-courses' ? (
            <Register />
          ) : id === 'mic-online-registration' ? (
            micOnlineForm && <ApplyForm form={micOnlineForm} />
          ) : (
            courses
              .filter((c) => c.tab === id)
              .map((c, n) => (
                <>
                  {n > 0 && <Divider />}
                  <CourseSection course={c} />
                </>
              ))
          )}
        </div>
      ))
    }
  </main>
  <Footer />
  <Lightbox />
</Base>

<style>
  /* With JavaScript on, only the active tab's panel is shown */
  :global(.js) .panel:not(.is-active) {
    display: none;
  }
  .panel {
    scroll-margin-top: 64px;
    padding-block: 0 clamp(32px, 5vw, 64px);
  }
  .panel--home,
  .panel--contact,
  .panel--all-courses,
  .panel--mic-online-registration {
    padding-block: 0;
  }
</style>
