---
/**
 * A small, dependency-free image carousel. Native horizontal scroll with snap (so it swipes on
 * touch and keeps working without JavaScript); the script adds dots, keeps them in sync, and
 * auto-advances. Auto-advance pauses on hover/focus and when the tab is hidden, and is off when the
 * visitor prefers reduced motion. Colors come from global.css variables, so it follows the theme.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  slides: Slide[];
  class?: string;
}
const { slides, class: className } = Astro.props;
---

<div class:list={['carousel', className]} data-carousel aria-roledescription="carousel" aria-label="Photos from our meditation courses">
  <div class="carousel__viewport" data-viewport>
    {
      slides.map((s, i) => (
        <figure class="carousel__slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
          <Image
            src={s.src}
            alt={s.alt}
            widths={[400, 640, 1280]}
            sizes="(max-width: 680px) 92vw, 620px"
            class="carousel__img"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </figure>
      ))
    }
  </div>
  <div class="carousel__dots" role="tablist" aria-label="Choose a photo" data-dots>
    {slides.map((_, i) => <button type="button" class="carousel__dot" role="tab" aria-label={`Show photo ${i + 1}`} data-dot={i} />)}
  </div>
</div>

<style>
  .carousel {
    width: 100%;
    max-width: 620px;
    margin-inline: auto;
  }
  .carousel__viewport {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: 8px;
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.28);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .carousel__viewport::-webkit-scrollbar {
    display: none;
  }
  .carousel__slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: center;
  }
  .carousel__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1428 / 661;
    object-fit: cover;
  }
  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 9px;
    margin-top: 16px;
  }
  .carousel__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(251, 245, 232, 0.4);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .carousel__dot[aria-selected='true'] {
    background: var(--gold-light);
    transform: scale(1.3);
  }
  .carousel__dot:focus-visible {
    outline: 2px solid var(--ivory);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel__viewport {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) setUp(root);

  function setUp(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
    const slides = [...viewport.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // One image: nothing to advance or dot.
    if (slides.length < 2) {
      root.querySelector('[data-dots]')?.remove();
      return;
    }

    let current = 0;
    const mark = (i: number) => {
      current = i;
      dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
    };
    const goTo = (i: number) =>
      viewport.scrollTo({ left: i * viewport.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });

    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

    // Keep the dots in step with swiping/scrolling.
    const seen = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) mark(slides.indexOf(e.target as HTMLElement));
    }, { root: viewport, threshold: 0.6 });
    slides.forEach((s) => seen.observe(s));
    mark(0);

    // Auto-advance, paused while the visitor is looking closely or the tab is hidden.
    let timer: number | undefined;
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (reduce.matches) return;
      timer = window.setInterval(() => goTo((current + 1) % slides.length), 5500);
    };
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }
</script>
