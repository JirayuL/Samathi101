---
import { Image, getImage } from 'astro:assets';
import class1 from '../assets/gallery/class-1.jpg';
import class2 from '../assets/gallery/class-2.jpg';
import wat from '../assets/gallery/wat-dhammamongkol.jpg';
import { contact } from '../data/site';

const gallery = [
  { src: class1, alt: 'Meditation class in a classroom' },
  { src: class2, alt: 'Meditation lecture in a conference hall' },
  { src: wat, alt: 'Aerial view of Wat Dhammamongkol, Bangkok' },
];
const photos = await Promise.all(
  gallery.map(async (g) => ({ ...g, full: await getImage({ src: g.src, format: 'webp', width: Math.min(g.src.width, 1800) }) }))
);
---

<section class="contact" id="contact-us">
  <div class="container">
    <div class="section-head">
      <h2>Contact us</h2>
      <p>Our English courses are run by the Meditation Courses in Foreign Language Department at Wat Dhammamongkol, Bangkok.</p>
    </div>

    <div class="gallery">
      {
        photos.map((g) => (
          <a href={g.full.src} data-lightbox="contact-photos" data-caption={g.alt} aria-label={`View larger: ${g.alt}`}>
            <Image src={g.src} alt={g.alt} widths={[360, 600]} sizes="(min-width: 760px) 33vw, 100vw" />
          </a>
        ))
      }
    </div>

    <div class="groups">
      {
        [contact.headquarters, contact.countries].map((group) => (
          <div class="group">
            <h3>{group.heading}</h3>
            <dl>
              {group.items.map((item) => (
                <div class="item">
                  <dt>{item.label}</dt>
                  <dd>
                    <a href={item.href} {...(item.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                      {item.value}
                    </a>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(48px, 7vw, 88px) var(--section-gap);
  }
  .gallery {
    display: grid;
    gap: 10px;
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  @media (min-width: 760px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .gallery a {
    display: block;
    cursor: zoom-in;
  }
  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
    transition: opacity 0.2s ease;
  }
  .gallery a:hover :global(img) {
    opacity: 0.88;
  }
  .groups {
    display: grid;
    gap: 40px 72px;
    max-width: 960px;
    margin-inline: auto;
  }
  @media (min-width: 820px) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  .group h3 {
    font-size: 23px;
    padding-bottom: 12px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--rule);
  }
  dl {
    margin: 0;
  }
  .item {
    margin-bottom: 16px;
  }
  dt {
    font-size: 14.5px;
    color: var(--forest-mute);
  }
  dd {
    margin: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
</style>
