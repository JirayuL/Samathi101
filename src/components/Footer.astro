---
import Lotus from './Lotus.astro';
const year = new Date().getFullYear();
// Shown by Analytics.astro when analytics is set up, to change the cookie choice
const analytics = !!(import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '').trim();
---

<footer class="footer">
  <div class="container">
    <Lotus size="small" class="footer__lotus" />
    <p class="footer__name">Willpower Institute Foundation</p>
    <p>Wat Dhammamongkol, Soi Sukhumvit 101, Bangkok, Thailand</p>
    <p class="footer__small">© {year} Willpower Institute Foundation, founded by Luangphor Viriyang Sirintharo</p>
    {
      analytics && (
        <p class="footer__small footer__settings">
          <button type="button" class="footer__link" data-cookie-settings hidden>
            Cookie settings
          </button>
        </p>
      )
    }
  </div>
</footer>

<style>
  .footer {
    background: var(--forest);
    color: rgba(251, 245, 232, 0.72);
    text-align: center;
    padding-block: 48px 40px;
    font-size: 15px;
  }
  .footer p {
    margin: 0 0 4px;
  }
  .footer :global(.footer__lotus) {
    margin: 0 auto 14px;
    color: var(--gold-light);
  }
  .footer__name {
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--ivory);
    margin-bottom: 6px !important;
  }
  .footer__settings {
    margin-top: 6px !important;
  }
  .footer__link {
    padding: 4px 0;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .footer__link:hover {
    color: var(--ivory);
  }
  .footer__link[hidden] {
    display: none;
  }
  .footer__small {
    margin-top: 18px !important;
    font-size: 13.5px;
    color: rgba(251, 245, 232, 0.55);
  }
</style>
