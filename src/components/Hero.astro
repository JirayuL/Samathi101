---
import Lotus from './Lotus.astro';
import { site } from '../data/site';
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <Lotus size="large" class="hero__lotus" />
    <h1 class="hero__title">
      {site.heroTitle}
      <span class="hero__subtitle">{site.heroSubtitle}</span>
    </h1>
    <p class="hero__line">{site.heroLine}</p>
    <a class="hero__cta" href="#all-courses">Register for a course</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--forest);
    color: var(--ivory);
    text-align: center;
    padding-block: clamp(48px, 8vw, 96px) clamp(56px, 9vw, 112px);
  }
  /* soft candle-light glow behind the lotus */
  .hero__glow {
    position: absolute;
    left: 50%;
    top: clamp(40px, 8vw, 90px);
    width: min(720px, 140vw);
    aspect-ratio: 1;
    transform: translate(-50%, -32%);
    background: radial-gradient(closest-side, rgba(226, 161, 59, 0.22), rgba(226, 161, 59, 0.06) 55%, transparent);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    max-width: 1000px;
  }
  .hero :global(.hero__lotus) {
    width: clamp(170px, 26vw, 250px);
    margin: 0 auto 28px;
    color: var(--gold-light);
  }
  .hero__title {
    font-weight: 400;
    color: var(--ivory);
    font-size: clamp(38px, 6.2vw, 68px);
    line-height: 1.08;
    letter-spacing: -0.005em;
  }
  .hero__subtitle {
    display: block;
    margin-top: 10px;
    font-style: italic;
    font-size: 0.46em;
    color: var(--gold-light);
    letter-spacing: 0.01em;
  }
  .hero__line {
    max-width: 560px;
    margin: 26px auto 0;
    color: rgba(251, 245, 232, 0.82);
    font-size: 17px;
  }
  .hero__cta {
    display: inline-block;
    margin-top: 34px;
    padding: 13px 28px;
    background: var(--saffron);
    color: var(--forest);
    font-weight: 600;
    text-decoration: none;
    border-radius: 3px;
    transition: background-color 0.2s ease;
  }
  .hero__cta:hover {
    background: #ecb456;
    color: var(--forest);
  }
  .hero__cta:focus-visible {
    outline-color: var(--ivory);
  }
</style>
