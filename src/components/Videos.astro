---
import { videos } from '../data/videos';

const embedUrl = (id: string, start?: number) =>
  `https://www.youtube-nocookie.com/embed/${id}${start ? `?start=${start}` : ''}`;
---

<section class="videos">
  <div class="container">
    <div class="section-head">
      <h2>Videos</h2>
    </div>
    <div class="list">
      {
        videos.map((v) => (
          <figure class="video">
            <div class="frame">
              <iframe
                src={embedUrl(v.youtubeId, v.start)}
                title={v.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
            <figcaption>
              <a href={`https://www.youtube.com/watch?v=${v.youtubeId}${v.start ? `&t=${v.start}s` : ''}`} target="_blank" rel="noopener">
                Watch on YouTube
              </a>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .videos {
    padding-block: clamp(48px, 7vw, 88px) var(--section-gap);
  }
  .list {
    display: grid;
    gap: 48px;
    max-width: 880px;
    margin-inline: auto;
  }
  .video {
    margin: 0;
  }
  /* same thin gold mount as the course images */
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    padding: 8px;
    background: #fff;
    border: 1px solid var(--rule);
  }
  .frame iframe {
    position: absolute;
    inset: 8px;
    width: calc(100% - 16px);
    height: calc(100% - 16px);
    border: 0;
  }
  figcaption {
    margin-top: 10px;
    font-size: 15px;
    text-align: right;
  }
</style>
