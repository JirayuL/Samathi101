---
/**
 * Gold-leaf lotus line drawing.
 * size="large" draws itself in once on page load (respects reduced-motion).
 * size="small" is the ornament used in dividers and the footer.
 */
interface Props {
  size?: 'large' | 'small';
  class?: string;
}
const { size = 'large', class: className } = Astro.props;
const animate = size === 'large';
---

{
  size === 'large' ? (
    <svg
      class:list={['lotus', animate && 'lotus--draw', className]}
      viewBox="0 0 240 152"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle class="l-halo" cx="120" cy="72" r="62" pathLength="1" />
      <path class="l-4" pathLength="1" d="M114 122C84 132 50 126 28 108C58 106 92 110 114 122Z" />
      <path class="l-4" pathLength="1" d="M126 122C156 132 190 126 212 108C182 106 148 110 126 122Z" />
      <path class="l-3" pathLength="1" d="M116 121C86 124 58 104 46 74C74 82 102 100 116 121Z" />
      <path class="l-3" pathLength="1" d="M124 121C154 124 182 104 194 74C166 82 138 100 124 121Z" />
      <path class="l-2" pathLength="1" d="M118 120C96 112 78 82 78 42C98 58 114 88 118 120Z" />
      <path class="l-2" pathLength="1" d="M122 120C144 112 162 82 162 42C142 58 126 88 122 120Z" />
      <path class="l-1" pathLength="1" d="M120 120C104 96 102 52 120 20C138 52 136 96 120 120Z" />
      <path class="l-1 l-vein" pathLength="1" d="M120 108V44" />
      <path class="l-water" pathLength="1" d="M60 138H180" />
      <path class="l-water" pathLength="1" d="M92 146H148" />
    </svg>
  ) : (
    <svg
      class:list={['lotus-sm', className]}
      viewBox="0 0 48 28"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M24 24C20 18 19.5 9 24 2C28.5 9 28 18 24 24Z" />
      <path d="M23 24C17 22.5 12.5 16 12.5 8C17.5 11.5 21.5 17 23 24Z" />
      <path d="M25 24C31 22.5 35.5 16 35.5 8C30.5 11.5 26.5 17 25 24Z" />
      <path d="M22.5 24.5C15 26 7 23 2 17.5C9 17 17 19.5 22.5 24.5Z" />
      <path d="M25.5 24.5C33 26 41 23 46 17.5C39 17 31 19.5 25.5 24.5Z" />
    </svg>
  )
}

<style>
  .lotus {
    display: block;
    width: 100%;
    height: auto;
  }
  .l-halo {
    opacity: 0.28;
  }
  .l-vein,
  .l-water {
    opacity: 0.6;
  }
  .lotus-sm {
    display: block;
    width: 48px;
    height: 28px;
  }

  /* Draw-in: halo, then the petals from the outside in, then the water */
  .lotus--draw :is(path, circle) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: lotus-draw 1.6s cubic-bezier(0.45, 0, 0.25, 1) forwards;
  }
  .lotus--draw .l-halo {
    animation-duration: 2.4s;
  }
  .lotus--draw .l-4 {
    animation-delay: 0.3s;
  }
  .lotus--draw .l-3 {
    animation-delay: 0.6s;
  }
  .lotus--draw .l-2 {
    animation-delay: 0.9s;
  }
  .lotus--draw .l-1 {
    animation-delay: 1.2s;
  }
  .lotus--draw .l-water {
    animation-delay: 1.8s;
  }
  @keyframes lotus-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lotus--draw :is(path, circle) {
      stroke-dashoffset: 0;
    }
  }
</style>
